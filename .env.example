# Copy this file to .env for local live runs.
#
# Normal serving and trace-harness target-model calls use OpenRouter by default.
OPENROUTER_API_KEY=

# Optional: only needed when GEPA roles use native Anthropic model ids.
ANTHROPIC_API_KEY=

# Optional runtime overrides.
ATTUNE_BIND_ADDR=127.0.0.1:8080
ATTUNE_UPSTREAM_BASE_URL=https://openrouter.ai/api/v1
ATTUNE_TRACE_PATH=traces/attune.jsonl

# Optional logging.
RUST_LOG=attune=debug,tower_http=debug

# Optional GEPA role overrides. Defaults are Claude Sonnet 5 through OpenRouter.
ATTUNE_GEPA_REFLECTION_MODEL=anthropic/claude-sonnet-5
ATTUNE_GEPA_JUDGE_MODEL=anthropic/claude-sonnet-5
ATTUNE_GEPA_REFLECTION_BASE_URL=https://openrouter.ai/api/v1
ATTUNE_GEPA_JUDGE_BASE_URL=https://openrouter.ai/api/v1
